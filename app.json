{
  "expo": {
    "name": "智记账",
    "slug": "smart-ledger",
    "description": "智能记账 App：自然语言输入、AI 智能分类、固定收支自动记账、快捷记账、消费分析与深色模式",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "smartledger",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6366f1"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smartledger.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0E7C66"
      },
      "package": "com.smartledger.app"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-document-picker",
      "expo-system-ui"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dd21f782-08c2-4bf9-9203-cc5776f4aa8b"
      }
    },
    "owner": "lumos0726"
  }
}
